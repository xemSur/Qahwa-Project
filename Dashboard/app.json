{
  "expo": {
    "name": "قهوجية الحجاز - لوحة التحكم",
    "slug": "qahwaji-dashboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "qahwaji",
    "splash": {
      "backgroundColor": "#0f0a05",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qahwaji.dashboard",
      "infoPlist": {
        "CFBundleLocalizations": ["ar"],
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0a05"
      },
      "package": "com.qahwaji.dashboard",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      "expo-image"
    ],
    "extra": {
      "apiUrl": "http://localhost:8080/api/v1"
    }
  }
}
